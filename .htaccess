<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /pbzlms/

    # Allow direct access to Documentation
    RewriteCond %{REQUEST_URI} ^/pbzlms/Documentation [NC]
    RewriteRule ^ - [L]

    RewriteRule ^$ public/ [L,R=302]
    RewriteCond %{REQUEST_URI} !^/pbzlms/public/
    RewriteRule ^(.*)$ public/$1 [L,R=302]
</IfModule>