<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files (.env, .git, etc.)
    RewriteRule ^\.(.*) - [F,L]

    # Block direct access to storage logs and framework data
    RewriteRule ^storage/logs/.* - [F,L]
    RewriteRule ^storage/framework/.* - [F,L]

    # Allow direct access to Documentation if accessed
    RewriteCond %{REQUEST_URI} ^/Documentation [NC]
    RewriteRule ^ - [L]

    # Rewrite all root requests internally to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>